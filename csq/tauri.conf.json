{
  "$schema": "ui/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Code Squad Q",
  "version": "2.19.0",
  "identifier": "foundation.terrene.claude-squad",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ui && npm run dev",
    "beforeBuildCommand": "cd ui && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Code Squad Q",
        "width": 420,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src https://platform.claude.com https://github.com https://objects.githubusercontent.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxQzJGN0ZENzlGOTUyREQKUldUZFV2bDUvZmZDOFFEWU83V1J3TDZPb21wVXI2My9XVml2WWdHZWUxTG55SjUxY3JyVUY1M0gK",
      "endpoints": [
        "https://github.com/terrene-foundation/csq/releases/download/updater-manifest/latest.json",
        "https://github.com/terrene-foundation/csq/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage",
      "msi",
      "nsis"
    ],
    "publisher": "Terrene Foundation",
    "homepage": "https://github.com/terrene-foundation/csq",
    "shortDescription": "Multi-provider session manager for Claude Code",
    "longDescription": "Code Squad Q (csq) \u2014 run Claude Code against local models, third-party APIs, or pool multiple Claude Max subscriptions with per-terminal isolation and quota monitoring.",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "appPosition": {
          "x": 160,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 400,
          "y": 200
        },
        "windowSize": {
          "width": 560,
          "height": 400
        }
      }
    },
    "windows": {
      "wix": {
        "version": "2.0.21"
      }
    },
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libappindicator3-1"
        ],
        "section": "devel"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libappindicator-gtk3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
