#!/usr/bin/env bash
# csq pre-push hook — the missing wiring for scripts/verify/dev-push-guard.sh.
#
# WHY THIS FILE EXISTS
# --------------------
# `dev` is CI-free by construction: every push trigger under .github/workflows is
# `branches: [main]` or tags-only, so NOTHING DOWNSTREAM CATCHES A BAD PUSH TO IT.
# `scripts/ci/dev-preflight.mjs` writes a receipt keyed to the exact commit it
# checked, and `scripts/verify/dev-push-guard.sh` reads that receipt and refuses a
# push no preflight vouched for. Both were complete and correct, and the guard was
# invoked by NOTHING — only by comments in prose that mentioned it. 354 commits
# landed on this trunk with no gate firing, which is the structural reason this
# repo's defect classes survive. This hook is the missing invocation site, and it
# is VERSION-CONTROLLED (`.githooks/`, shipped and executable in the tree) rather
# than dropped into `.git/hooks/`, which does not survive a clone.
#
# THE LAYER, DELIBERATELY DISTINGUISHED
# -------------------------------------
# This is a GIT hook, not a `.claude/hooks/` hook, and the Claude Code hook
# protocol has no meaning here. There is no event/matcher to declare:
# hook-event-selection.md MUST-1 governs a `settings.json` registration, and no
# registration exists for this file. A git hook cannot return an `instructAndWait`
# body either (hook-output-discipline.md MUST-1) — it halts by exit status and by
# what it prints. What DOES carry over is that rule's reason, which is the whole
# point: a halt with no payload teaches nothing, so every refusal below names what
# happened and the one command that clears it. hook-output-discipline.md MUST-2 is
# honoured in substance as well — the verdict is read from the receipt's STRUCTURE
# (a JSON parse bound to a SHA), never matched out of a log with a regex.
#
# WHAT IS GATED: `dev` ONLY — and the dispatch cannot live anywhere else
# ----------------------------------------------------------------------
# The guard's subject is `dev`: its own header says so and its refusals name it.
# A pre-push hook is the only layer that knows WHICH ref is being pushed — the
# guard cannot, because what it reads is a receipt bound to HEAD, not to a ref. So
# the DISPATCH lives here and the VERDICT stays in the guard; this file parses no
# receipt and re-implements none of the guard's logic.
#
# Non-`dev` pushes (feature branches, tags) are NOT gated. They get CI through a
# PR, which is the thing `dev` does not have, and a hook that fired on them would
# be a false alarm on a legitimate operation — the reliable way to train an
# operator to override a guard. `main` is not gated either: pushing it directly is
# already BLOCKED by branch protection and git.md MUST NOT #1, and it runs CI.
#
# THREE OUTCOMES (durable-instruments.md MUST-2), propagated from the guard
# ------------------------------------------------------------------------
#   0  allow    the guard vouched for HEAD
#   1  BLOCK    determinate refusal — no receipt, a stale receipt, a RED or
#               UNDETERMINED gate recorded in it, or a commit being pushed that a
#               receipt bound to HEAD cannot name
#   2  BLOCK    UNDETERMINED — the guard could not MEASURE (unreadable or
#               malformed receipt, no verified python3, HEAD unresolvable). Never
#               folded into 0: reading "I could not check" as "cleared" reports
#               green in exactly the case this guard exists to catch.
# Any OTHER guard exit code is also 2 here. An unrecognised status must not fail
# open — that is the failure mode this whole family of gates is built against.
#
# Git aborts the push on any non-zero status; the codes are propagated rather than
# flattened to 1 so the distinction survives in the operator's scrollback.
#
# WIRING — one line, once per clone (`core.hooksPath` is not version-controlled)
#   git config --local core.hooksPath .githooks
# Run it from the repo root. See .githooks/README.md for why `--local`, not
# `--global`, and for what the setting still does not cover.
#
# TEST
#   bash scripts/tests/githooks-pre-push.test.sh   # 0 pass · 1 fail · 2 cannot measure
#
# USAGE
#   Git runs this with cwd at the worktree root and the refs being pushed on
#   stdin, one line of `<local ref> <local sha> <remote ref> <remote sha>` per
#   ref. It is not run by hand for a verdict; use the guard for that.
set -uo pipefail

# TWO DIFFERENT ROOTS, and the distinction is load-bearing rather than incidental.
# The GUARD is shipped CODE: it resolves from this file's own location, the same
# way the guard resolves its own lib, so the hook always runs the guard that
# version-controlled alongside it. The TREE BEING PUSHED is per-worktree STATE —
# it supplies HEAD and holds the receipt — so it resolves from git, which is what
# knows where this push is coming from. The two are the same directory in every
# real invocation (git runs this hook from the worktree root) and diverge only
# when the hook is exercised against a fixture repo, which is precisely what
# scripts/tests/githooks-pre-push.test.sh does. Resolving BOTH from git made the
# hook look for the guard inside the fixture, find nothing, and return 2 for every
# input — a state the test caught, and one in which its own cannot-measure cases
# passed for the wrong reason.
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GUARD="$HOOK_DIR/../scripts/verify/dev-push-guard.sh"

PUSH_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$PUSH_ROOT" ]; then
  printf '%s\n' "pre-push: BLOCKED (UNDETERMINED) — could not resolve the worktree root."
  printf '%s\n' "  There is no tree to look for a preflight receipt in, and 'I could not"
  printf '%s\n' "  look' is not 'there was nothing to find'. Re-run from inside the repo."
  exit 2
fi
if [ ! -f "$GUARD" ]; then
  printf '%s\n' "pre-push: BLOCKED (UNDETERMINED) — no gate at $GUARD"
  printf '%s\n' "  The reader that decides whether a preflight vouched for this push is"
  printf '%s\n' "  missing, so nothing checked it. Restore the guard, or push with"
  printf '%s\n' "  --no-verify if you have decided that deliberately."
  exit 2
fi

# `read -r _ <sha> <ref> _`: the 1st and 4th fields (local ref, remote sha) are
# not needed — matching on the remote ref (3rd) is what identifies the trunk, and
# that is the field git actually writes.
TRAILERS="$HOOK_DIR/../scripts/landing/check-trailers.sh"
while read -r _ local_sha remote_ref remote_sha; do
  # LANDING PROVENANCE — dev AND main. Every non-merge commit this push lands on
  # an integration branch must carry a Landed-From / Landed-Partial trailer
  # (scripts/landing/). A missing trailer is a HARD STOP, never a warning: once a
  # commit lands without its source recorded, nothing can reliably recover it.
  case "${remote_ref:-}" in
    refs/heads/dev | refs/heads/main)
      case "${local_sha:-}" in "" | 0000000000000000000000000000000000000000) ;; *)
        if [ ! -f "$TRAILERS" ]; then
          printf '%s\n' "pre-push: BLOCKED (UNDETERMINED) — no trailer gate at $TRAILERS"
          exit 2
        fi
        case "${remote_sha:-}" in
          "" | 0000000000000000000000000000000000000000)
            bash "$TRAILERS" "$local_sha" --not --remotes ;;
          *)
            bash "$TRAILERS" "${remote_sha}..${local_sha}" ;;
        esac
        trc=$?
        case "$trc" in
          0) ;;
          1) printf '%s\n' "pre-push: BLOCKED — commit(s) above lack a landing trailer."; exit 1 ;;
          *) printf '%s\n' "pre-push: BLOCKED (UNDETERMINED) — the trailer gate could not measure (exit $trc)."; exit 2 ;;
        esac ;;
      esac ;;
  esac

  case "${remote_ref:-}" in
    refs/heads/dev) ;;
    *) continue ;;
  esac

  # A DELETION carries the null sha and no tree to vouch for. Refused in its own
  # words rather than left to the HEAD comparison below, which would report it as
  # a stale receipt and send the operator looking for the wrong problem.
  case "${local_sha:-}" in
    "" | 0000000000000000000000000000000000000000)
      printf '%s\n' "pre-push: BLOCKED — this push DELETES refs/heads/dev."
      printf '%s\n' "  Deleting the trunk is not something a preflight receipt can vouch for."
      printf '%s\n' "  If that is genuinely intended, push it with --no-verify and say so."
      exit 1 ;;
  esac

  # THE RECEIPT IS BOUND TO HEAD, so it vouches for HEAD and for nothing else. A
  # fast-forward push of an ANCESTOR of HEAD succeeds at the git level, and the
  # guard — which asks git for HEAD, never for what is being pushed — would clear
  # it on the strength of a receipt naming a different commit. Git hands this hook
  # the pushed sha, so the one comparison the guard structurally cannot make is
  # made here. This is not duplicated receipt logic: it validates the guard's own
  # contract (HEAD-bound) against the input the guard cannot see.
  HEAD_SHA="$(git -C "$PUSH_ROOT" rev-parse HEAD 2>/dev/null || true)"
  if [ -z "$HEAD_SHA" ]; then
    printf '%s\n' "pre-push: BLOCKED (UNDETERMINED) — HEAD does not resolve in $PUSH_ROOT."
    exit 2
  fi
  if [ "$local_sha" != "$HEAD_SHA" ]; then
    printf '%s\n' "pre-push: BLOCKED — the push to refs/heads/dev is not HEAD."
    printf '%s\n' "  pushing:  ${local_sha:0:12}"
    printf '%s\n' "  HEAD:     ${HEAD_SHA:0:12}"
    printf '%s\n' "  A preflight receipt is bound to HEAD, so it does not vouch for any other"
    printf '%s\n' "  commit — which is the point of binding it to a SHA. Re-run"
    printf '%s\n' "  \`node scripts/ci/dev-preflight.mjs\` and push HEAD."
    exit 1
  fi

  bash "$GUARD" "$PUSH_ROOT"
  rc=$?
  case "$rc" in
    0) ;;
    1) printf '%s\n' "pre-push: BLOCKED — the preflight receipt does not clear this push."
       printf '%s\n' "  Fix what the guard named above, then re-run \`node scripts/ci/dev-preflight.mjs\`."
       exit 1 ;;
    2) printf '%s\n' "pre-push: BLOCKED (UNDETERMINED) — the guard could not measure (see above)."
       printf '%s\n' "  'Could not check' is not 'cleared'. Re-run \`node scripts/ci/dev-preflight.mjs\`."
       exit 2 ;;
    *) printf '%s\n' "pre-push: BLOCKED (UNDETERMINED) — the guard exited $rc, which is not one of its three outcomes."
       printf '%s\n' "  An unrecognised status is not a pass. Re-run \`node scripts/ci/dev-preflight.mjs\`."
       exit 2 ;;
  esac
done

# No `dev` ref on stdin: either a non-trunk push, or a by-hand invocation. Nothing
# for this gate to answer for, and neither is a reason to refuse.
exit 0
